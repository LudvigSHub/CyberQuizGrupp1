@using CyberQuizGrupp1.UI.Services
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthService AuthService

<div class="page">
    @* <div class="sidebar">
        <NavMenu />
    </div> *@
    <header class="app-header">
        @* visa endast knappen om vi INTE är på home page/start page *@
        @if (Navigation.Uri != Navigation.BaseUri)
        {
            <button class="btn-cyber" style="width: auto;" @onclick="GoBack">← Tillbaka</button>
        }
        else
        {   //osynlig knapp för att få samma storlek på headern även utan knappen:
            <button class="btn-cyber" style="width: auto; visibility: hidden;">← Tillbaka</button>
        }
        <h3 class="cyber-quiz" @onclick="GoToHome" style="cursor: pointer;">Cyber Quiz</h3>

       @*  logga ut knappen syns inte sålänge url INTE är baseuri (home page) OCH inte ifall url innehåller login eller register *@
        @if (Navigation.Uri != Navigation.BaseUri && !Navigation.Uri.Contains("/login") && !Navigation.Uri.Contains("/register"))
        {
            <div style="margin-left: auto; display: flex; gap: 0.5rem;">
            <button class="btn-cyber" @onclick="GoToAiCoaching">AI Coaching</button> 

            <button class="btn-cyber" @onclick="GoToUser">Mitt konto</button> 

        @*  KAN INTE vara en klassisk onclick metod (nedan) för att logga ut. navigation med forceload:true till /logout är en POST-endpoint, men navigateto gör en GET-request, fick ändra till form *@
        @* <button class="btn-cyber-danger" style="width: auto; margin-left: auto;" @onclick="Logout">Logga ut</button> *@
            <form action="/logout" method="post" style="width: 150px;">
                <AntiforgeryToken />
                    <button type="submit" class="btn-cyber-danger" style="width: 150px;">Logga ut</button>
            </form>
            </div>
        }
        </header>

    <main>
        <article class="content px-4 d-flex flex-column align-items-center justify-content-center" style="min-height: 80vh;">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void GoBack()
    {
        Navigation.NavigateTo("javascript:history.back()");
    }

    private void GoToHome()
    {
        //navigeras antingen till home eller categories beroende på om man är inloggad eller ej (tack vare OnInitialized i home pagen)
        Navigation.NavigateTo("/");
    }

    private void GoToUser()
    {
        Navigation.NavigateTo("/user");
    }

    public void GoToAiCoaching()
    {
        Navigation.NavigateTo("/AiCoaching");
    }

    //FUNKAR INTE:
    // private void Logout()
    // {
    //     //forceload:true för att cookien ska rensas 
    //     Navigation.NavigateTo("/logout", forceLoad: true);
    // }
}