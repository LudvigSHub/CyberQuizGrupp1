@using CyberQuizGrupp1.UI.Services
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthService AuthService

<div class="page">
    @* <div class="sidebar">
        <NavMenu />
    </div> *@
    <header class="app-header">
        @* visa endast knappen om vi INTE är på home page/start page *@
        @if (Navigation.Uri != Navigation.BaseUri)
        {
            <button class="btn-cyber" style="width: auto;" @onclick="GoBack">← Tillbaka</button>
        }
        else
        {   //osynlig knapp för att få samma storlek på headern även utan knappen:
            <button class="btn-cyber" style="width: auto; visibility: hidden;">← Tillbaka</button>
        }
        <h3 class="cyber-quiz">Cyber Quiz</h3>

       @*  logga ut knappen syns inte sålänge url INTE är baseuri (home page) OCH inte ifall url innehåller login *@
        @if (Navigation.Uri != Navigation.BaseUri && !Navigation.Uri.Contains("/login"))
        {
        <button class="btn-cyber-danger" style="width: auto; margin-left: auto;" @onclick="Logout">Logga ut</button>
        }
        </header>

    <main>
        @* <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div> *@

        <article class="content px-4 d-flex flex-column align-items-center justify-content-center" style="min-height: 80vh;">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void GoBack()
    {
        Navigation.NavigateTo("javascript:history.back()");
    }

    private void Logout()
    {
        //forceload:true för att cookien ska rensas 
        Navigation.NavigateTo("/", forceLoad: true);
    }
}