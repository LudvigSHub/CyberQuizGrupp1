@inject NavigationManager Navigation

<div class="category-card">
<h1 class="subcategory-title">@SubCategory.Name</h1>
<p class="question-count">Antal frågor: @SubCategory.QuestionCount</p>
    
@if (SubCategory.IsLocked)
{
    <button class="btn-cyber btn-cyber-locked" disabled>🔒 Låst</button>
}
else
{
    <button class="btn-cyber" @onclick="GoToQuiz">Starta quiz</button>
}
</div>


@code {

    [Parameter] //hämta en subcategory från parent page (subCategories.razor)
    public SubCategoryDTO SubCategory { get; set; } = new();

    private void GoToQuiz()
    {
        Navigation.NavigateTo($"/quiz/{SubCategory.Id}"); //LÄGG TILL PAGE")
    }

}
