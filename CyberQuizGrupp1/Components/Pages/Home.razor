@page "/"
@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>

<div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 80vh; position: relative;">
<h1 class="slogan">Slogan</h1>

<div class="d-flex flex-column gap-3">
<button class="btn-cyber" @onclick="GoToLoginPage">Logga in</button>
<button class="btn-cyber" @onclick="GoToRegisterPage">Registrera konto</button>
</div>
</div>

@code {

    private void GoToLoginPage()
    {
        Navigation.NavigateTo("/login");
    }

    private void GoToRegisterPage()
    {
        Navigation.NavigateTo("/register");
    }
}