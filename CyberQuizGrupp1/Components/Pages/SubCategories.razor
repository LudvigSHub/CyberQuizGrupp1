@page "/categories/{categoryId:int}/subcategories"
@using CyberQuizGrupp1.UI.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject SubCategoryService SubCategoryService
@inject UserService UserService
@rendermode InteractiveServer

<PageTitle>Categories</PageTitle>


<h1 class="mb-4">Välj en subkategori</h1>

<div class="d-flex flex-wrap gap-3 justify-content-center">

    @foreach (var sub in subCategories)
    {
        <SubCategoryCard SubCategory="@sub" />
        //parametern heter SubCategory från SubCategoryCard.razor, skicka varje subcategory i listan subCategories till SubCategoryCard
    }
</div>

@code {

    [Parameter]
    public int categoryId { get; set; } //hämta categoryId från url:en, se @page ovan MÅSTE HA SAMMA NAMN HÄR SOM I URL OVAN

    private List<SubCategoryDTO> subCategories = [];

    protected override async Task OnInitializedAsync()
    {
        var userId = await UserService.GetUserIdAsync();
        subCategories = await SubCategoryService.GetSubCategoriesAsync(categoryId, userId);
    }
}
