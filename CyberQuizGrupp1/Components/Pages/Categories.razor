@page "/categories"
@using CyberQuizGrupp1.UI.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject CategoryService CategoryService
@inject UserService UserService
@rendermode InteractiveServer

<PageTitle>Categories</PageTitle>


    <h1 class="mb-4">Välj en kategori</h1>

    <div class="d-flex flex-wrap gap-3 justify-content-center">

@foreach(var category in categories)
{
        <CategoryCard Category="@category" />
        //parametern heter Category från CategoryCard.razor, skicka varje category i listan categories till CategoryCard
}
</div>

@code {

    private List<CategoryDTO> categories = [];

    
    protected override async Task OnInitializedAsync()
    {
        // //hämtar användarid från metoden i UserService istället för att hämta det från urlen, det är säkrare eftersom vem som helst kan skriva in /userid... i urlen
        // var userId = await UserService.GetUserIdAsync();
        categories = await CategoryService.GetCategoriesAsync();
    }
}
