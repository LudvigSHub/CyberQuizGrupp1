@page "/login"
@using CyberQuizGrupp1.UI.Services
@inject NavigationManager Navigation
@inject AuthService AuthService
@* vem som helst kan nå denna page utan att vara inloggad via: *@
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous] 

<PageTitle>Login</PageTitle>

    <h1 class="mb-4">Logga in</h1>

<div>
    <EditForm Model="loginDTO" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />

        <div class="d-flex flex-column gap-3">
            <input type="text" placeholder="Användarnamn" @bind-value="loginDTO.Username" class="cyber-input" />
            <input type="password" placeholder="Lösenord" @bind-value="loginDTO.Password" class="cyber-input" />
            <button type="submit" class="btn-cyber">Logga in</button>

            <div style="min-height: 1.5rem; text-align: center;">
            @if(!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="cyber-message-danger">@ErrorMessage</p>
            }
            else
            {
                <p class="cyber-message">@Message</p>
            }
            </div>

                <div style="position: absolute; bottom: -20px; left: 50%; transform: translateX(-50%); white-space: nowrap;">
                <ValidationSummary />
            </div>
        </div>

    </EditForm>
</div>

@code {

    private LoginDTO loginDTO = new();
    private string ErrorMessage = "";
    private string Message = "";

    private async Task HandleLoginAsync()
    {
        Message = "Loggar in, vänligen vänta";
        ErrorMessage = "";
        StateHasChanged(); //tvingar blazor att rendera om så att texten syns med detsamma

        var success = await AuthService.LoginAsync(loginDTO);
        if(success)
        {
            Navigation.NavigateTo($"/auth/login?username={loginDTO.Username}", forceLoad: true); 
        }
        else
        {
            ErrorMessage = "Felaktigt användarnamn eller lösenord";
        }
    }
}
