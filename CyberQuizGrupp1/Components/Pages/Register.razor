@page "/register"
@using CyberQuizGrupp1.UI.Services
@inject NavigationManager Navigation
@inject AuthService AuthService
@rendermode InteractiveServer
@* vem som helst kan nå denna page utan att vara inloggad via: *@
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Register</PageTitle>

<h1 class="mb-4">Registrera konto</h1>

<div class="d-flex flex-column align-items-center">
    @* TILLFÄLLIG DEBUG:
    <p style="color: yellow;">@debugMessage</p> *@
    

    <EditForm Model="registerDTO" OnSubmit="HandleRegisterAsync" style="display: flex; flex-direction: column; align-items: center;">
        
        <div class="d-flex flex-column gap-3 align-items-center">
            <InputText placeholder="Användarnamn" @bind-Value="registerDTO.Username" class="cyber-input" />
            <InputText type="email" placeholder="Email" @bind-Value="registerDTO.Email" class="cyber-input" />
            <InputText type="password" placeholder="Lösenord" @bind-Value="registerDTO.Password" class="cyber-input" />
            <InputText type="password" placeholder="Bekräfta lösenord" @bind-Value="registerDTO.ConfirmPassword" class="cyber-input" />
            <button type="submit" class="btn-cyber" style="width: auto;">Registrera konto</button>

                <div style="min-height: 1.5rem; text-align: center">
                <p class="cyber-message" style="margin: 0;">@Message</p>
                <p class="cyber-message-danger" style="margin: 0;">@ErrorMessage</p> 
            </div>
        </div>
    </EditForm>
</div>

@code {

    private RegisterDTO registerDTO = new(); //hämta registerDTO så vi kan binda till propsen i den, se @bind-value ovan
    private string ErrorMessage = ""; // för att visa error meddelande om registrering misslyckas
    private string Message = "";

    // TILLFÄLLIG DEBUG:
    // private string debugMessage = ""; 


    private async Task HandleRegisterAsync()
    {
        if (string.IsNullOrEmpty(registerDTO.Username) ||
        string.IsNullOrEmpty(registerDTO.Email) ||
        string.IsNullOrEmpty(registerDTO.Password) ||
        string.IsNullOrEmpty(registerDTO.ConfirmPassword))
        {
            ErrorMessage = "Registrering misslyckades. Vänligen fyll i alla fält. Tänk på att din email måste innehålla @. Lösenorden måste matcha, vara längre än sju karaktärer långt coh innehålla minst en siffra. "; //visa för anävndaren om registreringen misslyckades
            StateHasChanged();

            await Task.Delay(10000);
            ErrorMessage = "";
            StateHasChanged();
            return;
        }

        if (registerDTO.Password != registerDTO.ConfirmPassword)
        {
            ErrorMessage = "Lösenorden matchar inte.";
            StateHasChanged();
            await Task.Delay(5000);
            ErrorMessage = "";
            StateHasChanged();
            return;
        }

        Message = "Registrerar användare, vänligen vänta";
        await Task.Delay(2000);
        ErrorMessage = "";
        StateHasChanged();

        var success = await AuthService.RegisterAsync(registerDTO); // anropa registerasync-metoden i authservice och skicka med registerDTO som innehåller användarens input
        if (success) // om registreringen lyckades, skicka vidare till login page
        {
            Navigation.NavigateTo("/login");
        }
        
    }
}
