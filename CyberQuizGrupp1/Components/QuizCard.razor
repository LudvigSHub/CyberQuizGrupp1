@using CyberQuizGrupp1.UI.Services
@inject QuizService QuizService
@inject UserService UserService


 <div>
@* quid *@


    @* hämtar questions från StartQuizDTO (namnet på StartQuizDTO är quiz) *@
     @foreach(var question in quiz.Questions)
    {
        <div> 
            @* per fråga i quizet, hämta frågan (Text är frågan (namnet i dton)) *@
            <h3>@question.Text</h3>
            @* per fråga i quizet, hämta svarsalternativen specifika för den frågan  *@
            @foreach(var answer in question.AnswerOptions)
            {
                <div>
                    @* för varje answer skapas en radiobutton + frågan skrivs bredvid. name används för att gruppera de radioknapaprna som tillhör varandra, 
                    tillhör ett question id, i detta fall ska de fyra answersen i foreachen grupperas till samma fråga, så vi sätter name question - question-Id för att svaret tillhör den frågan *@
                    @* koppla även varje radioknapp till ett id, så de svaret man klickar i får ett id. *@

                   @*  <input type="radio" name="question-question.Id" value="@answer.Id" 
                    @onchange="() => selectedAnswerId = answer.Id"/>  *@

                   @*  <input type="radio" name="question-question.Id" value="@answer.Id" 
                    @onchange="() => selectedAnswerId = answer.Id"/>  *@

                    <label>@answer.Text</label> @* skriver ut svaret bredvid knappen *@
                </div>
            }
        </div>
    }

</div>

@code {

    [Parameter] //hämta parametern från url:en (i detta fall id:t för den subkategori man klickar på följer med in i cardet (här)
    //behöver vara public efetrsom blazor sätter värdet åt oss från url:en (vilket id på subcategorin det är), inte vi själva. om vi själva sätter värde hade det kunna vara private
    public int SubCategoryId { get; set; }

    private StartQuizDTO? quiz; //quizet som hämtas från apiet i servicen (via OnInitializedAsync nedan) sparas här i. ? tillåter variablen att vara null

    private int currentQuestionIndex = 0; //field för att spara vilken fråga vi är på just nu (tex fråga 1, fråga 2 osv)
    private bool isSubmittingAnswer = false; //field för att hålla reda på om användaren redan har svarat på den frågan, förhindrar att man kan svara flera gånger på samma fråga
    private bool isFinished = false; //field för att hålla reda på om quizet redan är gjort eller inte
    private string message = ""; //field för att visa olika meddelande under quizet
    private int correctAnswers = 0; //field för att hålla reda på hur många rätta svar man fick
    private int totalQuestions = 0; //field för att hålla reda på hur många frågor där va totalt 

    protected override async Task OnInitializedAsync()
    {
        await UserService.LoadUserAsync();
        quiz = await QuizService.GetQuizAsync(SubCategoryId, UserService.UserId);
    }

    private async Task SubmitAnswer(int questionId, int answerOptionId)
    {
        //om antingen quizet är null eller om frågan redan är svarad på (isSubmittingAnswer) eller om quizet är klart - avbryt hela SubmitAnswer metoden direkt
        if (quiz is null || isSubmittingAnswer || isFinished) //quiz is null för om användaren klickar på ett svar innan quizet hunnit laddas kan quiz fortfarande vara null. is null ist för == null för det är modernare
            return;

        //detta körs om inget av det ovan stämmer, alltså 
        //om quizet är laddat, vi håller inte på att svara och quizet är inte klart, körs detta:
        isSubmittingAnswer = true; //sätter att vi håller på att svara på frågan
        message = ""; //rensar från tidigare messages från föregående fråga

        var dto = new SubmittedAnswerDTO
        {
            
        }

    }


}
