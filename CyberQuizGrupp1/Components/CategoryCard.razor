@inject NavigationManager Navigation


<div class="category-card" @onclick="GoToSubCategoryPage">
    <h3 class="category-title">@Category.CategoryName</h3>
    <p class="category-progress">Avklarade subkategorier: @Category.CompletedSubCategories/@Category.TotalSubCategories</p>
</div>


@code {

    [Parameter] //hämta en category från parent page (Categories.razor)
    public CategoryDTO Category { get; set; } = new();


    private void GoToSubCategoryPage()
    {
        Navigation.NavigateTo($"/categories/{Category.Id}/subcategories");
    }
}
